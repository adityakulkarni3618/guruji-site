# Copy this file to .env.local and fill in real values.

# ---- Database (Postgres) ----
# Free option: create a project at https://supabase.com (free tier) and copy
# the "Connection string" (URI, transaction pooler / port 6543 works best
# with serverless hosting like Vercel) from Project Settings > Database.
DATABASE_URL="postgres://user:password@host:6543/postgres"

# ---- Admin session security ----
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# ---- First admin login (used only by scripts/seed.js, run once) ----
ADMIN_NAME="Guruji Rahul Joshi"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
